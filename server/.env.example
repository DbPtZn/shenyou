# 服务
NODE_ENV=development
PORT=3000

# 数据库（Prisma / PostgreSQL）
DATABASE_URL=postgresql://user:password@localhost:5432/shenyou

# JWT：access 15 分钟 / refresh 30 天；secret 至少 32 字符
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=2592000

# CORS 显式白名单，逗号分隔（生产禁止 *）
CORS_ORIGINS=http://localhost:5173

# 6380 对应 docker-compose.yml 的 redis 映射（本机 6379 被既有容器占用）
REDIS_URL=redis://localhost:6380
# BullMQ 并发 worker 数
PIPELINE_CONCURRENCY=2
# 管线任务最大重试次数（耗尽后进死信队列）
PIPELINE_MAX_ATTEMPTS=5

# —— AI 厂商选择（先 mock 打通全链路，真实厂商后续接入）——
TTS_PROVIDER=mock
MUSIC_PROVIDER=mock
# Mock 提供者生成音频的时长（秒）
MOCK_TTS_DURATION_SEC=30
MOCK_MUSIC_DURATION_SEC=30

# —— 阿里云百炼 CosyVoice（TTS_PROVIDER=aliyun 时必填 API Key）——
# 百炼控制台 → API-KEY 管理（sk- 前缀，仅服务端持有，切勿下发客户端）
DASHSCOPE_API_KEY=
# 模型与默认音色（音色必须与模型匹配：见百炼「CosyVoice 音色列表」）
ALIYUN_TTS_MODEL=cosyvoice-v3-flash
# 章节 voiceId 为 default 时映射的真实音色
ALIYUN_TTS_VOICE=longanyang
# 网关地址：默认 https://dashscope.aliyuncs.com；可换业务空间专属域名
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
ALIYUN_TTS_TIMEOUT_SEC=60

# —— 腾讯云语音合成（TTS_PROVIDER=tencent 时必填 SecretId/SecretKey）——
# 访问管理 → API 密钥管理（https://console.cloud.tencent.com/cam/capi，仅服务端持有）
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_TTS_REGION=ap-guangzhou
# 默认音色 10510000 智逍遥（旁白阅读风格；完整音色列表见语音合成文档）
TENCENT_TTS_VOICE_TYPE=10510000
# SDK endpoint 覆盖仅用于本地模拟联调（如 localhost:8793），生产留空
TENCENT_TTS_ENDPOINT=
TENCENT_TTS_TIMEOUT_SEC=600
TENCENT_TTS_POLL_INTERVAL_MS=3000

# —— MiniMax 音乐生成（MUSIC_PROVIDER=minimax 时必填 API Key）——
# 注意：2026-08-20 起 MiniMax 付费音乐 API 不再面向新用户开放，需历史付费账号
MINIMAX_API_KEY=
MINIMAX_MUSIC_MODEL=music-3.0
# 网关地址：默认 https://api.minimaxi.com；可指向本地模拟服务器（无凭证联调）
MINIMAX_BASE_URL=https://api.minimaxi.com
# 生成约 30-60s，超时留足余量
MINIMAX_MUSIC_TIMEOUT_SEC=180

# —— Stability AI Stable Audio（MUSIC_PROVIDER=stable-audio 时必填 API Key）——
# 控制台 → API Keys（注册送 25 credits，Stable Audio 2.5 每次 20 credits）
STABILITY_API_KEY=
STABLE_AUDIO_MODEL=stable-audio-2.5
STABILITY_BASE_URL=https://api.stability.ai
# 2.5 模型 steps 4-8（默认 8）；2.0 模型 30-100
STABLE_AUDIO_STEPS=8
# 2.5 默认 cfg 1；2.0 默认 7
STABLE_AUDIO_CFG_SCALE=1
STABLE_AUDIO_TIMEOUT_SEC=300

# —— 腾讯云 MPS AIGC 音乐生成（MUSIC_PROVIDER=tencent 时必填 SecretId/SecretKey）——
# 复用上方腾讯 TTS 的同一对密钥；需先在媒体处理控制台开通 MPS 服务
# （https://console.cloud.tencent.com/mps）；计费按首，见 MPS 按量计费文档
# 模型：MiniMaxMusic（版本 2.0/2.5/2.6/3.0）、GL、EL、Mureka
TENCENT_MUSIC_MODEL_NAME=MiniMaxMusic
TENCENT_MUSIC_MODEL_VERSION=2.6
# SDK endpoint 覆盖仅用于本地模拟联调（如 localhost:8794），生产留空
TENCENT_MUSIC_ENDPOINT=
TENCENT_MUSIC_TIMEOUT_SEC=600
TENCENT_MUSIC_POLL_INTERVAL_MS=5000

# 对象存储（S3 兼容：本地 MinIO http://localhost:9000，生产 OSS/R2 换 endpoint）
S3_ENDPOINT=http://localhost:9000
# 预签名 URL 对外暴露的 endpoint。真机调试时必须设为开发机局域网 IP
# （如 http://192.168.x.x:9000），否则预签名 URL 里的 host 是 localhost，手机连不上。
# 默认回退到 S3_ENDPOINT。
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=shenyou-audio
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
# 预签名直传 URL 有效期（秒）
S3_PRESIGN_TTL_SEC=900

# CDN 分发：播放地址 = CDN_BASE_URL + objectKey + HMAC 签名
# 开发态指向本机 /audio 回源代理（服务端用 S3 SDK 从 RustFS 流式返回）
# 生产态指向真实 CDN（边缘按 CDN_SIGNING_SECRET 校验签名）
CDN_BASE_URL=http://localhost:3000/audio
CDN_SIGNING_SECRET=change-me-cdn-signing-secret-at-least-32
# 播放 URL 有效期（秒）
CDN_URL_TTL_SEC=3600

# —— RevenueCat 订阅计费（以下均可选：未配置的校验项自动跳过）——
# webhook Authorization 头共享密钥（RC dashboard → Integrations → Webhooks 配置）
REVENUECAT_WEBHOOK_AUTH=
# webhook HMAC 签名密钥（开启 HMAC signing 后由 RC 提供）；生产环境要求至少启用此项
REVENUECAT_WEBHOOK_SIGNING_SECRET=
# RevenueCat secret API key（sk_ 前缀，REST 对账用，仅服务端持有，切勿下发客户端）
REVENUECAT_SECRET_KEY=
REVENUECAT_API_BASE_URL=https://api.revenuecat.com
# 沙盒模拟接口开关（本地联调用；生产环境必须设为 false）
BILLING_SANDBOX_ENABLED=true
