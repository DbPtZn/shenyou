# 移动端环境变量（仅 EXPO_PUBLIC_ 前缀会打包进客户端，见 CLAUDE.md §6）
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
# 购买提供者：mock（本地模拟，Expo Go 可用）/ revenuecat（真实商店，需 dev build）
EXPO_PUBLIC_BILLING_PROVIDER=mock
# RevenueCat 公共 SDK key（revenuecat 模式必填；dashboard 按 App 获取）
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_xxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_xxxxxxxxxxxx
